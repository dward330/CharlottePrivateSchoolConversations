{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check_plain_language.mjs\" --hook",
            "timeout": 10,
            "statusMessage": "Checking plain language…"
          }
        ]
      }
    ]
  }
}
