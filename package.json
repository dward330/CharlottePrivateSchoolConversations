{
  "name": "charlotteprivateschoolconversations",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:metrics": "node scripts/check_metrics.mjs",
    "check:translations": "node scripts/check_translations.mjs",
    "i18n:report": "node scripts/i18n_extract.mjs --report",
    "preview": "vite preview",
    "check:hashes": "node scripts/check_hash_parity.mjs",
    "i18n:build": "node scripts/i18n_build_overlay.mjs",
    "check:runtime": "node scripts/check_runtime_resolution.mjs --lang fr",
    "check:fr": "node scripts/check_fr_identifiers.mjs",
    "check:currency": "node scripts/check_currency_shape.mjs",
    "check:money": "node scripts/check_money_render_paths.mjs",
    "check:bidi": "node scripts/check_rtl_bidi.mjs",
    "check:fa": "node scripts/check_fa_script.mjs"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
