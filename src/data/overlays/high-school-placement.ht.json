  "topic": "high-school-placement",
  "lang": "ht",
  "strings": [
    {
      "t": "De konseye pou high school, youn pou lekòl piblik ak lekòl endepandan e youn pou lekòl entènay — yon estrikti lekòl la te ajoute an 2023-24.",
      "of": "489258d4",
      "at": [
        "trinity-episcopal:placement.headline"
      ]
    },
    {
      "t": "Trinity prezante modèl K–8 la kòm chwazi yon high school nan fen 8yèm ane olye ke nan kòmansman Kindergarten.",
