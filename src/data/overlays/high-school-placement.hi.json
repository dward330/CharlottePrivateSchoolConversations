{
  "topic": "high-school-placement",
  "lang": "hi",
  "strings": [
    {
      "t": "दो high school counsellor, एक public और independent स्कूलों के लिए और एक boarding के लिए — यह ढाँचा स्कूल ने 2023-24 में जोड़ा।",
      "of": "489258d4",
      "at": [
        "trinity-episcopal:placement.headline"
      ]
    },
    {
      "t": "Trinity K–8 मॉडल को इस तरह प्रस्तुत करता है कि high school का चुनाव Kindergarten की शुरुआत में नहीं, बल्कि 8th grade के अंत में होता है।",
      "of": "5e77e274",
      "at": [
        "trinity-episcopal:placement.subhead"
      ]
    },
    {
      "t": "सरकारी + स्वतंत्र · boarding",
      "of": "d9161b1a",
      "at": [
        "trinity-episcopal:placement.stats[0].denominator"
      ]
    },
    {
      "t": "high school counsellor, प्रकाशित दायरे के अनुसार",
      "of": "1c352fe1",
      "at": [
        "trinity-episcopal:placement.stats[0].caption"
      ]
    },
    {
      "t": "Kindergarten से 8th grade तक",
      "of": "40a0591b",
