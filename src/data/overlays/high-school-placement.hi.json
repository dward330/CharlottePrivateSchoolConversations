      ]
    },
    {
      "t": "खोज शुरू होने से पहले एक ही कैंपस पर बीते वर्ष",
      "of": "bf5b96af",
      "at": [
        "trinity-episcopal:placement.stats[1].caption"
      ]
    },
    {
      "t": "पूरे Middle School के दौरान — स्कूलों को जानना",
      "of": "ca583a86",
      "at": [
        "trinity-episcopal:placement.steps[0].when"
      ]
    },
    {
      "t": "परिचय",
      "of": "504443a0",
      "at": [
        "trinity-episcopal:placement.steps[0].kind"
      ]
    },
    {
      "t": "public और independent placement की counsellor क्षेत्र के स्कूलों का दौरा करती हैं और, उनके शब्दों में, उन्हें “a feel for who might benefit from knowing this school” मिलता है, जिसके बाद वे परिवारों को उनकी चाहत के अनुसार उपयुक्त विकल्पों की ओर ले जाती हैं: “Do they want big class sizes? Are sports important? Extracurricular?”",
      "of": "e135fec4",
      "at": [
        "trinity-episcopal:placement.steps[0].text"
      ]
    },
    {
      "t": "Middle School — boarding का रास्ता, यदि परिवार चाहे",
      "of": "eed87b96",
      "at": [
        "trinity-episcopal:placement.steps[1].when"
      ]
    },
    {
      "t": "एक अलग रास्ता",
      "of": "f2125a71",
      "at": [
        "trinity-episcopal:placement.steps[1].kind"
      ]
    },
    {
      "t": "Boarding placement अलग से और किसी दूसरे व्यक्ति द्वारा संभाली जाती है। यहाँ यह कोई हाशिये का रास्ता नहीं है: 2004 के बाद से सभी graduates में से 12% boarding स्कूलों में गए, और गंतव्यों की सूची में Deerfield, Lawrenceville, Mercersburg, Woodberry Forest, St. Paul’s और The Taft School शामिल हैं।",
      "of": "05e13053",
      "at": [
        "trinity-episcopal:placement.steps[1].text"
      ]
    },
    {
      "t": "Grade 8 — निर्णय",
      "of": "ef786a6f",
      "at": [
        "trinity-episcopal:placement.steps[2].when"
      ]
    },
    {
      "t": "K–8 की मूल दलील",
      "of": "9c3a944a",
      "at": [
        "trinity-episcopal:placement.steps[2].kind"
      ]
    },
    {
      "t": "स्कूल का कहा हुआ तर्क यह है कि नौ वर्षों तक एक ही faculty द्वारा बच्चे को जानना बेहतर जानकारी पर आधारित चुनाव कराता है: अभिभावक “feel more confident about finding the high school that’s best suited for their child at the end of 8th Grade rather than at the beginning of Kindergarten.”",
      "of": "70182269",
      "at": [
        "trinity-episcopal:placement.steps[2].text"
      ]
    },
    {
      "t": "23 graduating classes में पंचानबे नामित high school — और उनमें से दस का अपना dossier यहाँ मौजूद है।",
      "of": "99d8d661",
      "at": [
        "trinity-episcopal:destinations.headline"
      ]
    },
    {
      "t": "यह Classes of 2004–2026 के लिए स्कूल की अपनी संचयी सूची है, जिसे इस आधार पर समूहबद्ध किया गया है कि हर गंतव्य वास्तव में है क्या। यह केवल नामों की सूची है: स्कूल न तो प्रति-स्कूल गिनती प्रकाशित करता है और न प्रति-वर्ष श्रेय, इसलिए किसी भी गंतव्य को “N students went there” के रूप में नहीं पढ़ा जाना चाहिए।",
      "of": "b9c27468",
      "at": [
