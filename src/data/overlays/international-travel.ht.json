{
  "topic": "international-travel",
  "lang": "ht",
  "strings": [
    {
      "t": "Yon sèl pwogram Global Education TK–12 — \"Inward. Outward. Forward.\" — ak vwayaj elèv aletranje nan Middle School ak Upper School, echanj resipwòk ak lekòl patnè, ak sa lekòl la rele premye Global Studies Diploma nan peyi a.",
      "of": "4b765798",
      "at": [
        "providence-day:lead.strong"
      ]
    },
    {
      "t": "Strategic Framework lekòl la konte Providence Day kòm youn nan sèlman sis lekòl nan tout peyi a ki ofri yon Global Studies Diploma epi ki se yon lekòl Round Square.",
      "of": "56a6b284",
      "at": [
        "providence-day:lead.muted"
      ]
    },
    {
      "t": "peyi ak teritwa",
      "of": "45713399",
      "at": [
        "providence-day:stats[0].label"
      ]
    },
    {
